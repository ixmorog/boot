#!/usr/bin/env bash
# Download the private installer from a fresh official Arch Linux ISO.
set -euo pipefail

require_live() {
    if [[ $EUID != 0 || ! -d /run/archiso || ! -d /sys/firmware/efi || $(uname -m) != x86_64 ]]; then
        echo 'Run from the official x86_64 Arch ISO, booted in UEFI, as root.' >&2
        return 1
    fi
    if [[ $(findmnt -n -o FSTYPE --target /run) != tmpfs ]]; then
        echo '/run must be tmpfs: login credentials must stay in RAM.' >&2
        return 1
    fi
}

require_terminal() {
    if [[ ! -t 0 || ! -t 1 ]]; then
        echo 'Download this script to a file, then run it with bash from a terminal.' >&2
        return 1
    fi
}

session_path() {
    printf '%s\n' /run/workstation-boot
}

check_private_directory() {
    if [[ -L "$1" || ! -d "$1" || $(stat -c '%u:%a' -- "$1") != "$EUID:700" ]]; then
        echo "Expected a private directory owned by the current user: $1" >&2
        return 1
    fi
}

cleanup_download() {
    local status=$1
    [[ -z ${download_dir:-} ]] || rm -rf -- "$download_dir"
    [[ -z ${pending_auth_dir:-} ]] || rm -rf -- "$pending_auth_dir"
    return "$status"
}

main() {
    if (( $# > 1 )) || [[ ${1:-} != '' && ${1:-} != --logout ]]; then
        echo 'Usage: bash /run/boot [--logout]' >&2
        return 2
    fi
    require_live
    local session_dir
    session_dir=$(session_path)
    if [[ -e "$session_dir" || -L "$session_dir" ]]; then
        check_private_directory "$session_dir"
        if [[ -e "$session_dir/auth" || -L "$session_dir/auth" ]]; then
            check_private_directory "$session_dir/auth"
        fi
    fi
    if [[ ${1:-} == --logout ]]; then
        rm -rf -- "$session_dir/auth"
        echo 'Local GitHub login cleared. Run the launcher again to sign in.'
        return 0
    fi
    require_terminal
    local command
    for command in curl tar sha256sum mktemp timeout; do
        command -v "$command" >/dev/null || { echo "Required command: $command" >&2; return 1; }
    done

    local gh_version=2.102.0
    local gh_sha256=bb766f710eef8ede859c18578c72c327597cd4c8a85b06001b1f3843c6019386
    local repository=ixmorog/homelab
    local gh_binary commit source_dir

    umask 077
    [[ -d "$session_dir" ]] || mkdir -m 700 -- "$session_dir"
    check_private_directory "$session_dir"
    # These globals let the EXIT trap clean failed downloads and partial logins.
    pending_auth_dir=''
    download_dir=$(mktemp -d /run/workstation-fetch.XXXXXX)
    trap 'cleanup_download "$?"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN GH_DEBUG
    export GH_CONFIG_DIR="$session_dir/auth" GH_HOST=github.com GH_NO_UPDATE_NOTIFIER=1

    echo 'Downloading GitHub CLI...'
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
        --retry 2 --connect-timeout 15 --max-time 180 \
        --output "$download_dir/gh.tar.gz" \
        "https://github.com/cli/cli/releases/download/v$gh_version/gh_${gh_version}_linux_amd64.tar.gz"
    printf '%s  %s\n' "$gh_sha256" "$download_dir/gh.tar.gz" | sha256sum --check --status || {
        echo 'GitHub CLI checksum mismatch. Stopping before execution.' >&2
        return 1
    }
    tar -xzf "$download_dir/gh.tar.gz" -C "$download_dir" --no-same-owner \
        "gh_${gh_version}_linux_amd64/bin/gh"
    gh_binary="$download_dir/gh_${gh_version}_linux_amd64/bin/gh"

    # Read only local credentials. A network failure must not force a new login.
    if "$gh_binary" auth token --hostname github.com >/dev/null 2>&1; then
        echo 'Using the GitHub login saved for this live session.'
    else
        rm -rf -- "$GH_CONFIG_DIR"
        mkdir -m 700 -- "$GH_CONFIG_DIR"
        pending_auth_dir=$GH_CONFIG_DIR
        echo 'Open https://github.com/login/device on your phone or another computer.'
        echo 'Enter the code shown below and authorize GitHub CLI.'
        # No Git credential helper or browser is needed in the live ISO.
        GH_PROMPT_DISABLED=1 timeout --foreground --kill-after=5 600 "$gh_binary" auth login \
            --hostname github.com --web --git-protocol https --insecure-storage --clipboard=false
        "$gh_binary" auth token --hostname github.com >/dev/null 2>&1 || {
            echo 'GitHub login did not save usable local credentials. Run the launcher again.' >&2
            return 1
        }
        pending_auth_dir=''
    fi

    if ! commit=$(timeout --kill-after=5 60 "$gh_binary" api "repos/$repository/commits/main" --jq .sha); then
        echo 'Could not fetch the installer revision. Your local login is saved; retry after resolving the reported error.' >&2
        echo 'If GitHub reports an invalid login, run: bash /run/boot --logout' >&2
        return 1
    fi
    [[ $commit =~ ^[0-9a-f]{40}$ ]] || { echo 'GitHub returned an invalid commit ID.' >&2; return 1; }
    echo "Downloading the installer from $repository at commit $commit..."
    timeout --kill-after=5 180 "$gh_binary" api "repos/$repository/tarball/$commit" > "$download_dir/source.tar.gz"

    # Keep source checkouts and session credentials in RAM for retries.
    umask 022
    source_dir=$(mktemp -d /run/homelab.XXXXXX)
    tar -xzf "$download_dir/source.tar.gz" -C "$source_dir" --strip-components=1 --no-same-owner
    [[ -f "$source_dir/workstation/bootstrap" && -f "$source_dir/workstation/install" ]] || {
        echo "The downloaded repository does not contain the installer: $source_dir" >&2
        return 1
    }

    rm -rf -- "$download_dir"
    trap - EXIT INT TERM
    unset GH_CONFIG_DIR GH_HOST GH_NO_UPDATE_NOTIFIER
    echo "Installer source saved to $source_dir"
    cd -- "$source_dir"
    exec bash workstation/bootstrap
}

if [[ ${BASH_SOURCE[0]:-} == "$0" || -z ${BASH_SOURCE[0]:-} ]]; then
    main "$@"
fi
